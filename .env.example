# TWS/Gateway socket connection. Confirm the actual port in the application.
MBT_HOST=127.0.0.1
MBT_PORT=4002
MBT_CLIENT_ID=17
MBT_ACCOUNT=DU1234567
MBT_ENVIRONMENT=paper

# read_only (default), paper_write, or live_write.
MBT_OPERATION_MODE=read_only
MBT_REQUEST_TIMEOUT_SECONDS=15
MBT_RECONNECT_ATTEMPTS=5
MBT_RECONNECT_BASE_DELAY_SECONDS=1
MBT_DATABASE_PATH=./var/mb_trader.db

# Application guardrails.
MBT_DISABLE_NEW_ORDERS=true
MBT_MAX_ORDER_QUANTITY=100
MBT_MAX_ORDER_NOTIONAL=10000
MBT_MAX_QUOTE_AGE_SECONDS=15
MBT_ALLOW_DELAYED_MARKET_DATA=false
MBT_ALLOW_REGULATORY_SNAPSHOT=false

# Live requires all three: live_write mode, true here, and the exact account listed.
MBT_ENABLE_LIVE_EXECUTION=false
MBT_LIVE_ACCOUNT_ALLOWLIST=
